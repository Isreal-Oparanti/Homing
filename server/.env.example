# Full list and meanings: docs/10-deployment-ops.md
ENV=local
# Supabase: Connect > Session pooler URI (postgresql:// is fine). Local Docker: the line below.
DATABASE_URL=postgresql+psycopg://homing:homing@127.0.0.1:5432/homing
TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
WORKER_THREADS=3
PROXY_SECRET=
ADMIN_TOKEN=
RUN_WORKER_IN_API=true

META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
YOUTUBE_API_KEY=
FEATURE_YT_CAPTIONS=true
MODEL_DAILY_TOKEN_BUDGET=5000000
MODEL_USER_DAILY_TOKEN_BUDGET=1500000
SPARK_MAX_CONCURRENCY=6
STORAGE_BACKEND=local
STORAGE_DIR=data/storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=saves
